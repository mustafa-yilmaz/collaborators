# Collaborators: the router of every request but Keycloak's, behind Caddy
# (which holds the certificates). Adapted from Docs' production template
# (docker/files/production/etc/nginx/conf.d/default.conf.template): the files
# are on MinIO, on this server, rather than an outside S3.
# Collaborators: search engines may index the cover page, the legal and
# guide pages, and what is published (pages, spaces and wikis, which tell
# themselves when they may not be indexed); nothing else. An empty value
# sends no header.
map $uri $collaborators_robots {
    default "noindex, nofollow";
    "~^/(home/?)?$" "";
    "~^/(page|space|wiki|legal-notice|privacy|accessibility|guide)/" "";
}

upstream docs_backend {
    server ${BACKEND_HOST}:8000 fail_timeout=0;
}

upstream docs_frontend {
    server ${FRONTEND_HOST}:3000 fail_timeout=0;
}

server {
    listen 8083;
    server_name _;
    charset utf-8;

    # increase max upload size
    client_max_body_size 20m;

    # Disables server version feedback on pages and in headers
    server_tokens off;

    proxy_ssl_server_name on;

    # Collaborators: see the map above (locations with headers of their own
    # repeat it)
    add_header X-Robots-Tag $collaborators_robots always;

    location = /robots.txt {
        default_type text/plain;
        return 200 "User-agent: *\nDisallow: /api/\nDisallow: /admin/\nDisallow: /media/\nDisallow: /account/\nDisallow: /registrations/\nDisallow: /invite/\nDisallow: /join/\nDisallow: /signin/\nDisallow: /login/\nDisallow: /profile/\nDisallow: /labels/\nDisallow: /workspaces/\nDisallow: /workspace/\nDisallow: /user-reconciliations/\nDisallow: /mcp\n";
    }

    location @proxy_to_docs_backend {
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        proxy_redirect off;
        proxy_pass http://docs_backend;
    }

    location @proxy_to_docs_frontend {
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        proxy_redirect off;
        proxy_pass http://docs_frontend;
    }

    location / {
        try_files $uri @proxy_to_docs_frontend;
    }

    location /api {
        try_files $uri @proxy_to_docs_backend;
    }

    location /admin {
        try_files $uri @proxy_to_docs_backend;
    }

    location /external_api {
        try_files $uri @proxy_to_docs_backend;
    }

    # Collaborators: the MCP server people's own AI assistants connect to,
    # and where it says to sign in (core/api/mcp.py)
    location = /mcp {
        try_files $uri @proxy_to_docs_backend;
    }

    location /.well-known/oauth-protected-resource {
        try_files $uri @proxy_to_docs_backend;
    }

    location /static {
        try_files $uri @proxy_to_docs_backend;
    }

    # Collaboration server. Only the routes below are published: it also serves
    # create-ydoc, reset-connections, migrate, restore-ydoc and reset-ydoc,
    # which the backend calls in-cluster and which must not be reachable from
    # the outside.
    location /collaboration/ws/ {
        # Ensure WebSocket upgrade
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";

        # Collaboration server
        proxy_pass http://${YHUB_HOST}:3002;

        # Set appropriate timeout for WebSocket
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;

        # Preserve original host and additional headers
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Origin $http_origin;
        proxy_set_header Host $host;
    }

    # Document routes, guarded by the same document authorization as the
    # websocket, and the public keys the collaboration server signs with.
    location ~ ^/collaboration/(ydoc|rollback|prune|changeset|activity|jwks)/ {
        proxy_pass http://${YHUB_HOST}:3002;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Origin $http_origin;
        proxy_set_header Host $host;
    }

    # Proxy auth for media
    location /media/ {
        # Auth request configuration
        auth_request /media-auth;
        auth_request_set $authHeader $upstream_http_authorization;
        auth_request_set $authDate $upstream_http_x_amz_date;
        auth_request_set $authContentSha256 $upstream_http_x_amz_content_sha256;

        # Pass specific headers from the auth response
        proxy_set_header Authorization $authHeader;
        proxy_set_header X-Amz-Date $authDate;
        proxy_set_header X-Amz-Content-SHA256 $authContentSha256;

        # Get resource from Minio
        proxy_pass http://minio:9000/${BUCKET_NAME}/;
        proxy_set_header Host minio:9000;

    
        add_header Content-Security-Policy "default-src 'none'" always;
        add_header X-Robots-Tag "noindex" always;
    }

    location /media-auth {
        proxy_pass http://docs_backend/api/v1.0/documents/media-auth/;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Original-URL $request_uri;

        # Prevent the body from being passed
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-Method $request_method;
    }
}
