# HTTPS for every address of Collaborators. Certificates come from Let's
# Encrypt on their own:
# - the sign-in server (Keycloak) at its own address;
# - every other address (the app, <workspace>.<domain>, wikis' own domains)
#   "on demand", after the backend says the address is ours (tls-allowed), so
#   nobody can make this server ask for certificates of other domains.
{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://frontend:8083/api/v1.0/tls-allowed/
	}
}

{$AUTH_HOST} {
	encode gzip
	reverse_proxy keycloak:8080
}

www.{$APP_HOST} {
	redir https://{$APP_HOST}{uri} permanent
}

https:// {
	tls {
		on_demand
	}
	encode gzip
	reverse_proxy frontend:8083 {
		header_up X-Forwarded-Proto https
	}
}
