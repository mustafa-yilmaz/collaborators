# Collaborators in production: the backend, its worker, the converter and the
# frontend's router read this file. Made by bin/init.sh, which fills in the
# addresses and random secrets; the <…> values are filled in by hand.

# -- Addresses
APP_HOST=__APP_HOST__
AUTH_HOST=__AUTH_HOST__
BACKEND_HOST=backend
FRONTEND_HOST=127.0.0.1
YHUB_HOST=yhub
YPROVIDER_HOST=y-provider
BUCKET_NAME=collaborators-media

# -- Django
DJANGO_SETTINGS_MODULE=impress.settings
DJANGO_CONFIGURATION=Production
DJANGO_SECRET_KEY=__DJANGO_SECRET_KEY__
# Wikis can have their own domains: Caddy only serves the addresses the backend
# vouches for (tls-allowed), so the backend accepts any host behind it
DJANGO_ALLOWED_HOSTS=*
DJANGO_CSRF_TRUSTED_ORIGINS=https://__APP_HOST__
PYTHONPATH=/app
LOGGING_LEVEL_HANDLERS_CONSOLE=INFO
LOGGING_LEVEL_LOGGERS_ROOT=INFO
LOGGING_LEVEL_LOGGERS_APP=INFO
THEME_CUSTOMIZATION_FILE_PATH=/app/impress/configuration/theme/collaborators.json
CONVERSION_UPLOAD_ENABLED=true
DOCSPEC_API_URL=http://docspec:3000/conversion

# -- Database, cache, tasks
DB_HOST=postgresql
DB_NAME=collaborators
DB_USER=collaborators
DB_PASSWORD=__DB_PASSWORD__
DB_PORT=5432
REDIS_URL=redis://redis:6379/1
DJANGO_CELERY_BROKER_URL=redis://redis:6379/0

# -- Files (MinIO on this server)
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_ACCESS_KEY_ID=collaborators
AWS_S3_SECRET_ACCESS_KEY=__MINIO_PASSWORD__
AWS_STORAGE_BUCKET_NAME=collaborators-media
MEDIA_BASE_URL=https://__APP_HOST__

# -- Collaboration server and converter
JWT_PRIVATE_KEY_FILE=/keys/private.pem
YHUB_API_BASE_URL=http://yhub:3002
COLLABORATION_API_URL=http://yhub:3002/collaboration
COLLABORATION_WS_URL=wss://__APP_HOST__/collaboration/ws/v1/docs
COLLABORATION_SERVER_ORIGIN=https://__APP_HOST__
COLLABORATION_BACKEND_BASE_URL=https://__APP_HOST__
Y_PROVIDER_API_BASE_URL=http://y-provider:4444/api/
Y_PROVIDER_API_KEY=__Y_PROVIDER_API_KEY__
COLLABORATION_LOGGING=true

# -- Signing in (Keycloak)
OIDC_OP_JWKS_ENDPOINT=https://__AUTH_HOST__/realms/collaborators/protocol/openid-connect/certs
OIDC_OP_AUTHORIZATION_ENDPOINT=https://__AUTH_HOST__/realms/collaborators/protocol/openid-connect/auth
OIDC_OP_TOKEN_ENDPOINT=https://__AUTH_HOST__/realms/collaborators/protocol/openid-connect/token
OIDC_OP_USER_ENDPOINT=https://__AUTH_HOST__/realms/collaborators/protocol/openid-connect/userinfo
OIDC_OP_LOGOUT_ENDPOINT=https://__AUTH_HOST__/realms/collaborators/protocol/openid-connect/logout
OIDC_RP_CLIENT_ID=collaborators
OIDC_RP_CLIENT_SECRET=__OIDC_CLIENT_SECRET__
OIDC_RP_SIGN_ALGO=RS256
OIDC_RP_SCOPES="openid email"
OIDC_AUTH_REQUEST_EXTRA_PARAMS={}
LOGIN_REDIRECT_URL=https://__APP_HOST__
LOGIN_REDIRECT_URL_FAILURE=https://__APP_HOST__
LOGOUT_REDIRECT_URL=https://__APP_HOST__
OIDC_REDIRECT_ALLOWED_HOSTS=["__APP_HOST__"]

# -- Collaborators
COLLABORATORS_SIGNIN_PROVIDERS=google,microsoft,linkedin
# New collaborators wait for a platform administrator to let them in
# (/registrations/); these emails, verified by their provider, are platform
# administrators let in at once. Also: python manage.py approve_registration
# <email> --admin
COLLABORATORS_SIGNUP_APPROVAL=true
COLLABORATORS_PLATFORM_ADMIN_EMAILS=admin@__APP_HOST__
COLLABORATORS_SIGNIN_PASSWORD=False
COLLABORATORS_ACCOUNT_URL=https://__AUTH_HOST__/realms/collaborators/account/account-security/linked-accounts
COLLABORATORS_WIKI_BASE_DOMAIN=__APP_HOST__
COLLABORATORS_APP_HOSTS=__APP_HOST__,www.__APP_HOST__
COLLABORATORS_WIKI_DOMAIN_TARGET=wikis.__APP_HOST__
COLLABORATORS_KEYCLOAK_URL=http://keycloak:8080
COLLABORATORS_KEYCLOAK_REALM=collaborators
COLLABORATORS_KEYCLOAK_CLIENT_ID=collaborators-backend
COLLABORATORS_KEYCLOAK_CLIENT_SECRET=__KEYCLOAK_BACKEND_SECRET__

# -- Email (fill in from your email service: SMTP)
DJANGO_EMAIL_HOST=<smtp host>
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=<smtp user>
DJANGO_EMAIL_HOST_PASSWORD=<smtp password>
DJANGO_EMAIL_USE_TLS=true
DJANGO_EMAIL_FROM=noreply@__APP_HOST__
DJANGO_EMAIL_BRAND_NAME="CO✍️✍️ABORATORS"
DJANGO_EMAIL_URL_APP=https://__APP_HOST__
