# HTTPS for every address of Collaborators. Certificates come from Let's
# Encrypt on their own:
# - the sign-in server (Keycloak) at its own address;
# - every other address (the app, <workspace>.<domain>, wikis' own domains)
#   "on demand", after the backend says the address is ours (tls-allowed), so
#   nobody can make this server ask for certificates of other domains.
{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://frontend:8083/api/v1.0/tls-allowed/
	}
}

{$AUTH_HOST} {
	encode gzip
	# Collaborators: the realm's metadata also at the address RFC 8414 builds
	# from the issuer, which AI assistants connecting to the MCP server ask
	# first (Keycloak serves it under /realms/<realm>/ only)
	@realm_metadata path_regexp realm_metadata ^/\.well-known/(oauth-authorization-server|openid-configuration)/realms/([^/]+)$
	rewrite @realm_metadata /realms/{re.realm_metadata.2}/.well-known/{re.realm_metadata.1}
	reverse_proxy keycloak:8080
}

www.{$APP_HOST} {
	redir https://{$APP_HOST}{uri} permanent
}

https:// {
	tls {
		on_demand
	}
	encode gzip
	reverse_proxy frontend:8083 {
		header_up X-Forwarded-Proto https
	}
}
